#!/usr/bin/env bash
set -euo pipefail

# Ensure Node.js v24 is available
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
"$script_dir/node" --version >/dev/null

# Generate tsconfig.json
cat >"$script_dir/../tsconfig.json" <<'EOF'
{
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["esnext"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": ["**/*.ts"]
}
EOF

npx --yes --package @typescript/native-preview tsgo
